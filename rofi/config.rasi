configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 13";
    
}

@theme "/dev/null"
// @import "/home/sam/.cache/wal/colors-rofi-dark.rasi"

* {
    background-color: transparent;
    text-color:       #cdd6f4;
    border-color:     rgba(203, 166, 247, 0.35);
    
    
    
    
    
}

window {
    background-color: rgba(17, 17, 27, 0.92);
    border:           0px solid;
    border-radius:    20px;
    width:            450px;
    padding:          12px;
}

inputbar {
    background-color: rgba(30, 30, 46, 0.95);
    border:           1px solid;
    border-radius:    12px;
    padding:          10px 14px;
    margin:           0 0 8px 0;
    children:         [entry];
}

entry {
    background-color: transparent;
    placeholder:      "Search...";
    placeholder-color: #a6adc8;
}

listview {
    background-color: transparent;
    lines:            7;
    scrollbar:        false;
    spacing:          3px;
}

element {
    background-color: transparent;
    border-radius:    10px;
    padding:          8px 12px;
    spacing:          10px;
}

element selected {
    background-color: rgba(203, 166, 247, 0.15);
    text-color:       #cba6f7;
    border:           1px solid;
}

element-icon {
    background-color: transparent;
    size:             22px;
}

element-text {
    background-color: transparent;
    text-color:       #a6adc8;
}

element selected .element-text {
    text-color: #cba6f7;
}
